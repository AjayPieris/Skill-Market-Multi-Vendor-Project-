// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. THE USER (Can be Admin, Vendor, or Customer)
model User {
  id        String   @id @default(uuid()) // Unique ID like "a1b2-c3d4"
  email     String   @unique
  clerkId   String   @unique // We will link this to authentication later
  name      String?
  bio       String?  // For vendors (e.g. "I am an expert designer")
  image     String?  // Profile picture URL
  
  role      String   @default("customer") // "admin", "vendor", or "customer"
  isBlocked Boolean  @default(false) // Admin can block users

  // Following / Followers
  following Follow[] @relation("FollowFollower")
  followers Follow[] @relation("FollowFollowing")

  gigs      Gig[]    // A User (Vendor) can own many Gigs
  orders    Order[]  // A User (Customer) can have many Orders
  reviews   Review[] // Reviews written by this user
  createdAt DateTime @default(now())

  conversationsInitiated Conversation[] @relation("UserOne")
  conversationsReceived  Conversation[] @relation("UserTwo")
  messages               Message[]
  statuses               Status[]       // User's story posts
}

// Stories / Status (like Instagram Stories / WhatsApp Status)
model Status {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  mediaUrl  String
  mediaType String   // "image" | "video"
  caption   String?

  expiresAt DateTime // createdAt + 24 h — filtered on every query
  createdAt DateTime @default(now())

  views     StatusView[]

  @@index([userId])
  @@index([expiresAt])
}

model StatusView {
  id       String   @id @default(uuid())
  statusId String
  status   Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewerId String   // DB user id of the viewer (no hard FK to keep schema clean)
  viewedAt DateTime @default(now())

  @@unique([statusId, viewerId])
  @@index([statusId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id])

  followingId String
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id])

  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// 2. THE GIG (The Service being sold)
model Gig {
  id                 String   @id @default(uuid())
  title              String
  description        String
  price              Int
  imageUrl           String   // Thumbnail for the gig
  images             String[] @default([]) // NEW: Extra images. Up to 4 total images can be uploaded
  category           String   // e.g. "Design", "Web Dev"

  // Standard Package details
  packageDescription String?  // e.g. "I will provide a high-quality service..."
  deliveryDays       Int      @default(3)   // e.g. 3
  revisions          String   @default("Unlimited") // e.g. "Unlimited" or "3"

  // RELATIONSHIP: A Gig belongs to ONE Vendor (User)
  vendorId    String
  vendor      User     @relation(fields: [vendorId], references: [id])

  orders      Order[]  // A Gig can have many Orders
  reviews     Review[] // A Gig can have many Reviews

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // soft delete — null means active
}

// NEW: The Order Model
model Order {
  id              String   @id @default(uuid())
  price           Int      // Price paid at that time
  status          String   @default("pending") // pending, completed
  stripeSessionId String?  @unique // Prevents duplicate orders on page refresh

  // Who bought it?
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id])

  // What did they buy?
  gigId     String
  gig       Gig      @relation(fields: [gigId], references: [id])

  review    Review?  // One order can have at most one review

  createdAt DateTime @default(now())
}

// Review — only buyers who placed an order can leave a review
model Review {
  id         String   @id @default(uuid())
  rating     Int      // 1 – 5
  comment    String

  orderId    String   @unique // one review per order
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  gigId      String
  gig        Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)

  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([gigId])
  @@index([reviewerId])
}

model Conversation {
  id        String   @id @default(uuid())
  
  userOneId String
  userOne   User     @relation("UserOne", fields: [userOneId], references: [id])
  
  userTwoId String
  userTwo   User     @relation("UserTwo", fields: [userTwoId], references: [id])

  messages  Message[]

  // Ensures these two people only have ONE conversation together
  @@unique([userOneId, userTwoId]) 
}

model Message {
  id             String       @id @default(uuid())
  content        String
  imageUrl       String?
  
  // NEW FIELD:
  isRead         Boolean      @default(false)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])

  createdAt      DateTime     @default(now())
}